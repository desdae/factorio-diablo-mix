{
  "name": "emberforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Emberforge: Ashes of the Lattice — an isometric action RPG fused with an industrial automation simulation.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest run tests/stress.test.ts",
    "validate": "vitest run tests/content.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
